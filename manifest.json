{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "1.0.0",
  "description": "Block distracting websites during focus sessions. Pomodoro timer with customizable blocklist.",

  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest"],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "declarative_net_request": {
    "rule_resources": [{
      "id": "block_rules",
      "enabled": false,
      "path": "rules.json"
    }]
  },

  "commands": {
    "toggle-focus": {
      "suggested_key": { "default": "Alt+F" },
      "description": "Toggle focus mode"
    }
  }
}
